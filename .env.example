# ZERO TOWER BATTLE (ZTB) – Environment Configuration
# ==================================================

# Device Configuration
DEVICE_NAME=Pi-Ritter-X
HOSTNAME=zero-tower-battle
PI_VERSION=1
RAM_MB=512
CPU_FREQ=1

# Character Configuration
CHARACTER_NAME=Pi-Held
CHARACTER_CLASS=Krieger
CHARACTER_LEVEL=1
LANGUAGES=de,en

# Hardware Configuration
WLAN0=192.168.4.1
WLAN0_MODE=ap
WLAN0_CHANNEL=6
WLAN0_PASS=ZeroBattle2026!
TUN0_BASE=10.42.0
TUN0_IFACE=tun0
BLE_ENABLED=true

# Battle Configuration
MAX_ROUNDS=30
WORLD_BOSS_ENABLED=true
CHECKPOINT_INTERVAL=300
WORLD_BOSS_INTERVAL=259200  # 3 days in seconds

# Network Configuration
SSH_PORT=2222
HTTP_PORT=8000
TCP_PORT=5005
BACKUP_INTERVAL=300
MAX_CLIENTS=50

# Inventory Configuration
MAX_SLOTS=9
SHOP_ITEMS=3
SHOP_REFRESH=86400  # 24 hours

# Battle Configuration
PVP_ENABLED=true
PVE_ENABLED=true
DIFFICULTY_SCALING=1.15

# Security
FORWARD_DROP=true
WLAN0_INPUT_DROP=true
TUN0_PVP_ONLY=true

# BLE Configuration
BLE_MAC_PREFIX=0xFEAA
BLE_NAME_PREFIX=ZTB_

# Backup Configuration
BACKUP_INTERVAL=300
BACKUP_PATH=/home/ZTB_Service/battle_game/backups
MAX_BACKUPS=100

# Logging
LOG_LEVEL=INFO
LOG_PATH=/home/ZTB_Service/battle_game/logs
LOG_ROTATE=30

# Auto-Start
SYSTEMD_ENABLED=true
AUTOSTART_ENABLE=true

# Debug
DEBUG_LOG=true
DEBUG_MODE=false
VERSION=2.0.0

# SD Card Protection
SD_BACKUP_PATH=/home/ZTB_Service/battle_game/backups/character
SD_SYNC_INTERVAL=300

# Python Packages
PYTHON_VERSION=3.8
PIP_INDEX_URL=https://pypi.org/simple

# Optional Dependencies (install with apt)
INSTALL_TMUX=true
INSTALL_LOG2RAM=true
INSTALL_IFTOP=true
