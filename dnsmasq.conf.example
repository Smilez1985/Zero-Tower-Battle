# ZERO Tower Battle (ZTB) - dnsmasq DHCP Configuration
# =======================================================================
# DHCP Settings für Access Point:
# ├─ Interface: wlan0
# ├─ IP: 192.168.4.1
# ├─ Range: .10-.50
# └─ DNS: 192.168.4.1

interface=wlan0
dhcp-range=192.168.4.10,192.168.4.50,12h
dhcp-option=3,192.168.4.1
dhcp-option=6,192.168.4.1
no-resolv
bogus-priv
